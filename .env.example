# Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE=536870912
TEMP_DIRECTORY=./backend/data/ops
OP_TTL_SECONDS=3600
# History/op database location. Defaults to ./backend/data/history.db;
# on write-only platforms (Vercel /tmp) set this to an ephemeral path.
HISTORY_PATH=./backend/data/history.db
# FFMPEG_PATH=/usr/bin/ffmpeg

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/api